{
  "info": {
    "name": "Smart Grocery API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{ "key": "baseUrl", "value": "http://localhost:8080" }],
  "item": [
    {
      "name": "List products",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/products" }
    },
    {
      "name": "Get product by id",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/products/1" }
    },
    {
      "name": "Products by category",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/products/category/Dairy" }
    },
    {
      "name": "Natural language search",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"I want something healthy for breakfast, high protein\",\n  \"limit\": 10\n}"
        },
        "url": "{{baseUrl}}/api/search"
      }
    },
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" }
    }
  ]
}
